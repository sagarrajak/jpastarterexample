<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="created_bids_table_relation" author="sagar">
        <createTable tableName="bids">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"  />
            </column>
            <column name="amount" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text" />
            <column name="created_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_date" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="bigint" />
        </createTable>
    </changeSet>
</databaseChangeLog>